<core:FragmentDefinition
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:config="sap.gantt.config"
	xmlns:gnt2="sap.gantt.simple"
	xmlns:rm="sap.ui.table.rowmodes">
	<gnt2:GanttChartWithTable id="FreightOrder" ghostAlignment="Start" adhocLineLayer="Bottom"
			shapeSelectionMode = "MultiWithKeyboard"
			enableChartOverflowToolbar="true"
			shapeSelectionSettings="{color:'sapNegativeElementColor', strokeDasharray:'1,0'}"
			shapeDrop=".onShapeDrop"
			shapeDoubleClick=".onShapeDoubleClick"
			class="foGanttCard"
			>
		<gnt2:table>
			<Table
				selectionMode="Single"
				selectionBehavior="RowSelector"
				enableColumnReordering="true"
				fixedColumnCount = "1"
				rows="{
					path: 'data>/Requirements',					
					parameters: {
						operationMode: 'Server'
					}
				}">
				<extension>
					<m:OverflowToolbar class="foToolbar">
						<m:Title text="Freight Order Planning" level="H2"/> 
						<m:ToolbarSpacer/>
						
						<m:Button icon="sap-icon://expand-all" type="Transparent" press=".showUtilization"/>
						<m:Button icon="sap-icon://collapse-all" type="Transparent" press=".hideUtilization"/>
						<m:Button icon="sap-icon://refresh"/>	
						<!-- <m:Select forceSelection="false" selectedKey="FO" change=".onHierarchyChange">
							<m:items>
								<core:ListItem key="FOFU" text="Freight Order and Freight Unit"/> 
								<core:ListItem key="FO" text="Freight Order"/>
								 <core:ListItem key="FU" text="Freight Unit"/> 
							</m:items>
						</m:Select> -->
						<!-- <m:Button text="Create" type="Transparent" press=".onCreate"/>	
						<m:Button text="Delete" type="Transparent" press=".onDelete"/> -->
					</m:OverflowToolbar>
				</extension>
				<rowMode>
					<rm:Auto minRowCount="5"/>
				</rowMode>
				<rowSettingsTemplate>
					<gnt2:GanttRowSettings rowId="{data>id}">
						<gnt2:shapes1>
							<core:Fragment fragmentName="dispatcherns.dispatcherproj.view.Requirement" type="XML" />
						</gnt2:shapes1>
						<gnt2:calendars>
							<gnt2:BaseCalendar shapeId="{data>id}" calendarName="{data>id}" fill="#e0ded6"/>  
							<!-- <gnt2:BaseCalendar  shapeId="data>id" calendarName="Weekend" fill="#b9d3e4"/> -->
						</gnt2:calendars>
					</gnt2:GanttRowSettings>
				</rowSettingsTemplate>
				<core:Fragment fragmentName="dispatcherns.dispatcherproj.view.SharedTableColumn" type="XML"/>
			</Table>
			
		</gnt2:table>

		<gnt2:axisTimeStrategy>
			<core:Fragment fragmentName="dispatcherns.dispatcherproj.view.AxisTimeStrategy" type="XML"/> 
		</gnt2:axisTimeStrategy>		
	</gnt2:GanttChartWithTable>

</core:FragmentDefinition>