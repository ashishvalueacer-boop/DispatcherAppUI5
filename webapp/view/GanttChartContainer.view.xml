<mvc:View height="100%"		
    	  width="100%"
		  displayBlock="true"
          controllerName="dispatcherns.dispatcherproj.controller.GanttChartContainer"
          xmlns="sap.ui.table"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:core="sap.ui.core"
          xmlns:m="sap.m"
          xmlns:gnt2="sap.gantt.simple">
	<m:Page title="Dispatcher Cockpit for Driver and Vehicle assignment with Freight order"   showNavButton="true" contentOnlyBusy="true">
	<m:customHeader>
	<m:OverflowToolbar>
			<!-- <m:Title text="Dispatcher Cockpit- Driver and Truck Availability Freight Assignment" /> -->
			<m:ToolbarSpacer/>
			<m:Button text="Use AI Proposal" icon="sap-icon://ai" type="Emphasized" press=".onUseAIProposal"/>
			<m:Button text="AI Settings" icon="sap-icon://action-settings" press=".onAISettings"/>
			<m:Button text="AI Analytics" icon="sap-icon://line-chart"   press=".onAIAnalytics"/>
			<m:Button text="Driver Regulations" icon="sap-icon://world" tooltip="Maintain EU Driver Regulations" press=".onEURegulations"/>
			<m:Button text="Zone Settings" icon="sap-icon://action-settings" tooltip="Custom Personalization" press=".onOpenZoneSettings"/>
			</m:OverflowToolbar>
	</m:customHeader>
	   
		<gnt2:GanttChartContainer id="container" enableTimeScrollSync="true"  enableAutoFocusOnZoom="true">
			<gnt2:toolbar>				
				<gnt2:ContainerToolbar id="toolbar" design="Auto" showBirdEyeButton="true" showLegendButton="true" ganttSidePanel=".onGanttSidePanel" showSearchButton="true">		
				<m:OverflowToolbar class="customGanttToolbar">
				 <m:Label text="From Date" class="sapUiTinyMarginEnd dashboardHeader"/>
				 <m:DateTimePicker
                       value=""
                       displayFormat="dd MMM yyyy HH:mm"
                       valueFormat="yyyy-MM-dd'T'HH:mm:ss"
                        width="250px"
                        id="dpFromDate" 
                        change=".onDateChange"/>
						
				 <m:Label text="To Date" class="sapUiSmallMarginBegin sapUiTinyMarginEnd dashboardHeader" />	
				  <m:DateTimePicker
                        value=""
                       displayFormat="dd MMM yyyy HH:mm"
                       valueFormat="yyyy-MM-dd'T'HH:mm:ss"
                        width="250px"
                        id="dpToDate"
                        change=".onDateChange"/>
						
				  <m:Label text="Warehouse" class="sapUiTinyMarginEnd dashboardHeader"/>				  
				   <m:Select id="ownerSelect" class="sapUiTinyMarginEnd" forceSelection="false" selectedKey="0001000589" change=".onOwnerChange">				   
				   	<m:items>									
							<core:Item key="All" text="All"/>
							<core:Item key="0017411710" text="1710"/>
							<core:Item key="0001000589" text="1010"/>
					</m:items>
					</m:Select>
					<m:ToolbarSpacer />
					<m:Button
                        text="Go"
                        type="Emphasized"
                        press=".onFilter"
                    />
                    <m:Button
                        text="Reset"
                        type="Transparent"
                    />	
				</m:OverflowToolbar>		
				 		

					<!-- <m:Select id="layoutSelect" forceSelection="false" selectedKey="ReqAndRes" change=".onLayoutChange">
						<m:items>						
							<core:Item key="ReqAndResAndDrv" text="Requirement And Resource and Driver"/>
							<core:Item key="ReqAndDrv" text="Requirement And Driver"/>
							<core:Item key="ReqAndRes" text="Requirement And Resource"/>
							<core:Item key="Requirement" text="Requirement"/>
							 <core:Item key="Resource" text="Resource"/>							 
							<core:Item key="Drivers" text="Drivers"/> 
						</m:items>
					</m:Select> -->
					<gnt2:legendContainer>
						<gnt2:LegendContainer id="legendContainer" width="250px" height="270px" enableFlatLegends="true">
							<gnt2:ListLegend id="listLegend" title="Requirement Document">
								<gnt2:ListLegendItem interactive="false" selected="true" interactiveChange=".onLegendItemInteractiveChange">
									<gnt2:BaseRectangle shapeId="legendItemFO" fill="#99D101" title="Freight Order" showTitle="false"/>
								</gnt2:ListLegendItem>
								<!-- <gnt2:ListLegendItem interactive="false" selected="false">
									<gnt2:BaseRectangle shapeId="legendItemFU" stroke="#99D101" strokeWidth="2" strokeDasharray="2" fill="#fff" title="Freight Unit" showTitle="false"/>
								</gnt2:ListLegendItem> -->
							</gnt2:ListLegend>
							<gnt2:ListLegend id="listLegend1" title="Calenders" visible="true">
								<gnt2:ListLegendItem interactive="false" selected="false">
									<gnt2:BaseRectangle shapeId="legendItemWeekends" fill="#cccccc" title="Weekends" showTitle="false"/>
								</gnt2:ListLegendItem>
								<gnt2:ListLegendItem interactive="false" selected="false">
									<gnt2:BaseRectangle shapeId="legendItemNonworkingTime" fill="#666666" title="Non Working Time" showTitle="false"/>
								</gnt2:ListLegendItem>
							</gnt2:ListLegend>
						</gnt2:LegendContainer>
					</gnt2:legendContainer>
					
				</gnt2:ContainerToolbar>
			</gnt2:toolbar>
			<!-- ///Start of Change: 16 September 2026
				    Release -1:0					
					Desc:  Changed Code to replace FreightOrderAndFreightUnit with FreightOrder View -  					
					-->
			<!-- <core:Fragment fragmentName="dispatcherns.dispatcherproj.view.FreightOrderAndFreightUnit" type="XML"/> -->			
			<core:Fragment fragmentName="dispatcherns.dispatcherproj.view.FreightOrder" type="XML"/>
			<!--End of Change: 16 September 2026 !-->

			 <core:Fragment fragmentName="dispatcherns.dispatcherproj.view.Truck" type="XML"/> 
			 <core:Fragment fragmentName="dispatcherns.dispatcherproj.view.DriverView" type="XML"/>   

		</gnt2:GanttChartContainer>
		<m:Toolbar>
			<m:ToolbarSpacer />
			<m:Button  text="Save"  icon="sap-icon://save"  type="Emphasized"  press=".onSaveData" />
		</m:Toolbar>		 
	</m:Page>
</mvc:View>