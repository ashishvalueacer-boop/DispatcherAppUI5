<core:FragmentDefinition 
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:config="sap.gantt.config"
	xmlns:gnt2="sap.gantt.simple">
	<gnt2:BaseRectangle 
		shapeId="{data>id}" countInBirdEye="true"
		time="{
        path: 'data>startTime',
        formatter: '.formatter.dateToObject'}"
    	endTime="{
        path: 'data>endTime',
        formatter: '.formatter.dateToObject'}"		
		resizable="false" selectable="true" draggable= "true"
		title="{data>id}" showTitle="true"
		tooltip="{= 'Freight Order - ' + ${data>id} + '\nStart Time - ' + ${data>startTime} + '\nEnd Time - ' + ${data>endTime} }"
		stroke="{
			parts: [
				'FO',
				'planned'
			],
			formatter: '.formatter.strokeColor'
		}"
		strokeWidth="{
			parts: [
				'FO',
				'planned'
			],
			formatter: '.formatter.strokeWidth'
		}"
		strokeDasharray="{
			parts: [
				'FO',
				'planned'
			],
			formatter: '.formatter.strokeDasharray'
		}"
		fill="{
			parts: [
				'FO',
				'planned'
			],
			formatter: '.formatter.fillColor'
		}"
		/>

	
</core:FragmentDefinition>