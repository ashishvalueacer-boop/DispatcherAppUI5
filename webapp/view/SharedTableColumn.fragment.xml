<core:FragmentDefinition 
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core">

	<Column sortProperty="id" filterProperty="id">
		<m:Text text="Freight Order ID" wrapping="false"/>
		<template>
			<m:HBox>
				<m:items>
					 <!-- <core:Icon class="sapUiSmallMarginEnd"	src="sap-icon://{= ${data>Veh_id} !== '' ? 'shipping-status' : 'product'}" size="1.25rem" /> 
					<core:Icon class="sapUiSmallMarginEnd" src="sap-icon://{= ${data>driver_id} !== '' ? 'employee' : 'person-placeholder'}" size="1.25rem" /> -->
					<m:Label text="{data>id}"/>
				</m:items>
			</m:HBox>
		</template>
	</Column>
	<Column >
		<m:Text text="Resource Assignment" wrapping="false"/>
		<template>
			<m:HBox>
				<m:items>
					<core:Icon class="sapUiSmallMarginEnd"	src="sap-icon://{= ${data>Veh_id} !== '' ? 'shipping-status' : 'product'}" size="1.25rem" /> 
					<core:Icon class="sapUiSmallMarginEnd" src="sap-icon://{= ${data>driver_id} !== '' ? 'employee' : 'person-placeholder'}" size="1.25rem" />					
				</m:items>
			</m:HBox>
		</template>
	</Column>
	<Column sortProperty="startDate" filterProperty="startDate">
		<m:Text text="Start Time" wrapping="false"/>
		<template>
			<m:Label text="{data>startTime}"/>
			
			<!-- <core:Icon src="sap-icon://{= ${data>PlanStatus} === 'planned' ? 'status-completed' : 'status-inactive'}"
						tooltip="{= ${data>PlanStatus} === 'planned' ? 'Planned' : 'Unplanned' }"
						size="1.25rem" 
						color="{= ${data>PlanStatus} === 'planned' ? 'Positive' : 'Negative' }"/> -->
		</template>
	</Column>
	<Column sortProperty="endDate" filterProperty="endDate">
		<m:Text text="End Time" wrapping="false"/>
		<template>
			<m:Label text="{data>endTime}"/>
			
			<!-- <core:Icon src="sap-icon://{= ${data>PlanStatus} === 'planned' ? 'status-completed' : 'status-inactive'}"
						tooltip="{= ${data>PlanStatus} === 'planned' ? 'Planned' : 'Unplanned' }"
						size="1.25rem" 
						color="{= ${data>PlanStatus} === 'planned' ? 'Positive' : 'Negative' }"/> -->
		</template>
	</Column>

	<Column sortProperty="sourceLocation" filterProperty="sourceLocation">
		<m:Text text="Source Location" wrapping="false"/>
		<template>
			<m:Label text="{data>sourceLocation}"/>
		</template>
	</Column>

	<Column sortProperty="carrier" filterProperty="carrier">
		<m:Text text="Carrier" wrapping="false"/>
		<template>
			<m:Label text="{data>carrier}"/>
		</template>
	</Column>
	<!-- <Column sortProperty="driver_id" filterProperty="driver_id">
		<m:Text text="Driver Assigned" wrapping="false"/>
		<template>
			<m:Label text="{= ${data>driver_id} !== '' ? ${data>driver_id} : 'Driver Not Assigned' }" />
		</template>
	</Column> 
	<Column sortProperty="Veh_id" filterProperty="Veh_id">
		<m:Text text="Vehicle Id" wrapping="false"/>
		<template>
			<m:Label text="{data>Veh_id}"/>
		</template>
	</Column>  -->
</core:FragmentDefinition>