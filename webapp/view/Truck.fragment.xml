<core:FragmentDefinition
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:config="sap.gantt.config"
	xmlns:gnt2="sap.gantt.simple"
	xmlns:gnt-cal="sap.gantt.def.cal"
	xmlns:demokit="dispatcherns.dispatcherproj"
	xmlns:rm="sap.ui.table.rowmodes"
	core:require="{
		formatMessage: 'sap/base/strings/formatMessage'
	}">
	
	<gnt2:GanttChartWithTable id="Truck" ghostAlignment="Start" adhocLineLayer="Bottom"
			shapeSelectionMode = "Multiple"
			enableChartOverflowToolbar="true"
			shapeSelectionSettings="{color:'sapNegativeElementColor', strokeDasharray:'1,0'}"
			shapeDrop=".onShapeDrop"
			shapeResize=".onOrderRescheduled"
			shapeDoubleClick=".onShapeDoubleClick"
			class="truckGanttCard">
			
		<gnt2:table >
		
			<Table
				selectionMode="Single"
				selectionBehavior="RowSelector"
				enableColumnReordering="true"
				fixedColumnCount = "1"				
				rows="{
					path: 'data>/Resources',
					parameters: {
						operationMode: 'Server'						
					}
				}">
				<extension>
					<m:OverflowToolbar class="truckToolbar">
						<m:Title text="Vehicle Planning" level="H2" /> 
						<m:ToolbarSpacer/>
						<m:Button icon="sap-icon://expand-all" type="Transparent" press=".showUtilization"/>
						<m:Button icon="sap-icon://collapse-all" type="Transparent" press=".hideUtilization"/>
						<m:Button icon="sap-icon://refresh"/>						
					</m:OverflowToolbar>
				</extension>
				<rowMode>
					<rm:Auto minRowCount="5"/>
				</rowMode>
				<rowSettingsTemplate>
					<gnt2:GanttRowSettings rowId="{data>resourceId}" shapes1="{data>AvailabilityShapes}" shapes2="{data>FOShapes}">						
						<gnt2:calendars>
							<gnt2:BaseCalendar shapeId="{data>resourceId}" calendarName="{data>resourceId}" fill="#e0ded6"/>
						</gnt2:calendars> 
						 <gnt2:shapes1>
							<gnt2:BaseDiamond>
							</gnt2:BaseDiamond>	

							<gnt2:BaseRectangle
								shapeId="{data>shapeId}"
								time="{
								path:'data>StartTime',
								formatter:'.formatter.dateToObject'
								}"
								endTime="{
								path:'data>EndTime',
								formatter:'.formatter.dateToObject'
								}"
								fill="#22C55E"
								height="25"							
								countInBirdEye="true"
								showTitle="true"
								tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>resourceId',
												'data>StartTime',
												'data>EndTime'
											],
											formatter: 'formatMessage'
									}"
								expandable="true" selectable="true" draggable="true" resizable="true"/>					

							<!-- <gnt2:BaseRectangle
								    visible="{= ${data>AvailabilityShapes/0} ? true : false }"
									shapeId="{data>AvailabilityShapes/0/shapeId}"
									time="{
        								path: 'data>AvailabilityShapes/0/StartTime',
        								formatter: '.formatter.dateToObject'}"
