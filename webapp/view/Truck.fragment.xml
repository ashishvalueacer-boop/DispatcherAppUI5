												'i18n>VehicleTooltip',
												'data>resourceId',
												'data>AvailabilityShapes/0/StartTime',
												'data>AvailabilityShapes/0/EndTime'
											],
											formatter: 'formatMessage'
									}"
									expandable="true" selectable="true" draggable="true" resizable="true"/>

									<gnt2:BaseRectangle
								    visible="{= ${data>AvailabilityShapes/1} ? true : false }"
									shapeId="{data>AvailabilityShapes/1/shapeId}"
									time="{
        								path: 'data>AvailabilityShapes/1/StartTime',
        								formatter: '.formatter.dateToObject'}"
									endTime="{
        								path: 'data>AvailabilityShapes/1/EndTime',
        								formatter: '.formatter.dateToObject'}"
									 fill="#99D101"
									countInBirdEye="true" height="25"
									title = "{
												parts:[
													{ path:'' }
																										
												],
												formatter: '.formatter.orderTitle'
											}"
									showTitle="true"
									tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>AvailabilityShapes/1/resourceId',
												'data>AvailabilityShapes/1/StartTime',
												'data>AvailabilityShapes/1/EndTime'
											],
											formatter: 'formatMessage'
									}"
									expandable="true" selectable="true" draggable="true" resizable="true"/>

									<gnt2:BaseRectangle
								    visible="{= ${data>AvailabilityShapes/2} ? true : false }"
									shapeId="{data>AvailabilityShapes/2/shapeId}"
									time="{
        								path: 'data>AvailabilityShapes/2/StartTime',
        								formatter: '.formatter.dateToObject'}"
									endTime="{
        								path: 'data>AvailabilityShapes/2/EndTime',
        								formatter: '.formatter.dateToObject'}"
									 fill="#99D101"
									countInBirdEye="true" height="25"
									title = "{
												parts:[
													{ path:'' }												
												],
												formatter: '.formatter.orderTitle'
											}"
									showTitle="true"
									tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>AvailabilityShapes/2/resourceId',
												'data>AvailabilityShapes/2/StartTime',
												'data>AvailabilityShapes/2/EndTime'
											],
											formatter: 'formatMessage'
									}"
									expandable="true" selectable="true" draggable="true" resizable="true"/>

									<gnt2:BaseRectangle
								    visible="{= ${data>AvailabilityShapes/3} ? true : false }"
									shapeId="{data>AvailabilityShapes/3/shapeId}"
									time="{
        								path: 'data>AvailabilityShapes/3/StartTime',
        								formatter: '.formatter.dateToObject'}"
									endTime="{
        								path: 'data>AvailabilityShapes/3/EndTime',
        								formatter: '.formatter.dateToObject'}"
									 fill="#99D101"
									countInBirdEye="true" height="25"
									title = "{
												parts:[
													{ path:'' }
																								
												],
												formatter: '.formatter.orderTitle'
											}"
									showTitle="true"
									tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>AvailabilityShapes/3/resourceId',
												'data>AvailabilityShapes/3/StartTime',
												'data>AvailabilityShapes/3/EndTime'
											],
											formatter: 'formatMessage'
									}"
									expandable="true" selectable="true" draggable="true" resizable="true"/>

									<gnt2:BaseRectangle
								    visible="{= ${data>AvailabilityShapes/4} ? true : false }"
									shapeId="{data>AvailabilityShapes/4/shapeId}"
									time="{
        								path: 'data>AvailabilityShapes/4/StartTime',
        								formatter: '.formatter.dateToObject'}"
									endTime="{
        								path: 'data>AvailabilityShapes/4/EndTime',
        								formatter: '.formatter.dateToObject'}"
									 fill="#99D101"
									countInBirdEye="true" height="25"
									title = "{
												parts:[
													{ path:'' }
												],
												formatter: '.formatter.orderTitle'
											}"
